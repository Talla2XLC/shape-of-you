NODE_ENV=development
HOST=0.0.0.0
PORT=3001
DATABASE_URL=postgresql://shape_of_you_identity:shape_of_you_identity@localhost:5433/shape_of_you_identity
DATABASE_POOL_MAX=10
IDENTITY_PUBLIC_ORIGIN=http://localhost:3001
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME="Shape of You"
IDENTITY_TOTP_ACTIVE_KEY_ID=local-v1
IDENTITY_TOTP_ENCRYPTION_KEYS={"local-v1":"AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE"}
# Optional OAuth runtime. Generate real local-only values; do not copy examples into deployment.
# IDENTITY_OAUTH_ACTIVE_SIGNING_KEY_ID=local-v1
# IDENTITY_OAUTH_SIGNING_KEYS={"local-v1":"<base64url-pkcs8-p256-private-key>"}
# IDENTITY_OAUTH_COOKIE_KEYS=["<base64url-32-byte-secret>"]
# IDENTITY_OAUTH_RESOURCE=http://api.localhost:3000/mcp
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
