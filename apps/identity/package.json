{
  "name": "@shape-of-you/identity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "dev:local": "node --watch --env-file=.env.local --import tsx src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint src test vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:migrate:local": "node --env-file=.env.local --import tsx src/database/migrate.ts",
    "account:bootstrap": "tsx src/commands/bootstrap-account.ts",
    "account:subject": "tsx src/commands/show-account-subject.ts",
    "oauth-client:provision": "tsx src/commands/provision-oauth-client.ts",
    "oauth-client:reconcile-predefined": "tsx src/commands/reconcile-predefined-oauth-clients.ts"
  },
  "dependencies": {
    "@simplewebauthn/server": "13.3.2",
    "drizzle-orm": "^0.45.2",
    "oidc-provider": "9.11.1",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testcontainers/postgresql": "^11.7.2",
    "@types/oidc-provider": "9.11.0",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
