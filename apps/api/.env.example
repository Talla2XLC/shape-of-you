NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://shape_of_you_api:shape_of_you_api@localhost:5432/shape_of_you_api
LOG_LEVEL=info
PERSON_CONTEXT_MODE=synthetic
SYNTHETIC_PERSON_ID=00000000-0000-4000-8000-000000000001
# Set all three to enable the local OAuth-protected MCP endpoint.
# IDENTITY_OAUTH_ISSUER=http://127.0.0.1:3001
# IDENTITY_OAUTH_JWKS_URI=http://127.0.0.1:3001/oauth/jwks
# IDENTITY_OAUTH_RESOURCE=http://127.0.0.1:3000/mcp
SHUTDOWN_TIMEOUT_MS=10000
# Runtime-injected only. Grant this identity read-only access to the exact
# Fitness Tracker workbook; never commit a real private key.
# FITNESS_TRACKER_PERSON_ID=00000000-0000-4000-8000-000000000001
# GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=shape-of-you-api@example.iam.gserviceaccount.com
# GOOGLE_SHEETS_SERVICE_ACCOUNT_PRIVATE_KEY=runtime-secret
