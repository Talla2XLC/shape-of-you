worker_processes auto;
pid /tmp/nginx.pid;

events {
    worker_connections 512;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format edge '${EDGE_CLIENT_ADDRESS} - $remote_user [$time_local] '
                    '"$request" $status $body_bytes_sent '
                    '"$http_referer" "$http_user_agent"';
    access_log /dev/stdout edge;
    error_log /dev/stderr warn;
    server_tokens off;

    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;

    limit_req_zone ${EDGE_CLIENT_ADDRESS} zone=api_per_ip:10m rate=5r/s;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    server {
        listen 8081;
        access_log off;

        location = /edge-health {
            default_type application/json;
            return 200 '{"status":"ok"}';
        }

        location / {
            return 404;
        }
    }

    server {
        listen 8080 default_server;
        server_name _;
        return 444;
    }

    server {
        listen 8080;
        server_name staging.shape-of-you.ru identity.staging.shape-of-you.ru;

        location ^~ /.well-known/acme-challenge/ {
            root /var/www/certbot;
            default_type text/plain;
            try_files $uri =404;
        }

        location / {
            return 308 https://$host$request_uri;
        }
    }

    server {
        listen 8443 ssl ${EDGE_PROXY_PROTOCOL} default_server;
        server_name _;

        ssl_certificate /etc/nginx/tls/shape-of-you-staging/fullchain.pem;
        ssl_certificate_key /etc/nginx/tls/shape-of-you-staging/privkey.pem;

        return 444;
    }

    server {
        listen 8443 ssl ${EDGE_PROXY_PROTOCOL};
        server_name staging.shape-of-you.ru;

        ssl_certificate /etc/nginx/tls/shape-of-you-staging/fullchain.pem;
        ssl_certificate_key /etc/nginx/tls/shape-of-you-staging/privkey.pem;

        client_max_body_size 64k;

        add_header Strict-Transport-Security "max-age=86400" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;

        location = / {
            default_type application/json;
            return 200 '{"status":"staging","service":"shape-of-you"}';
        }

        location = /edge-health {
            access_log off;
            default_type application/json;
            return 200 '{"status":"ok"}';
        }

        location = /.well-known/oauth-protected-resource {
            limit_req zone=api_per_ip burst=20 nodelay;

            proxy_pass http://api:3000/.well-known/oauth-protected-resource;
            proxy_http_version 1.1;
            proxy_connect_timeout 5s;
            proxy_send_timeout 30s;
            proxy_read_timeout 30s;

            proxy_set_header Host $host;
            proxy_set_header X-Request-Id $request_id;
            proxy_set_header X-Real-IP ${EDGE_CLIENT_ADDRESS};
            proxy_set_header X-Forwarded-For ${EDGE_FORWARDED_FOR};
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Connection "";
        }

        location = /api {
            return 308 /api/;
        }

        location /api/ {
            limit_req zone=api_per_ip burst=20 nodelay;

            proxy_pass http://api:3000/;
            proxy_http_version 1.1;
            proxy_connect_timeout 5s;
            proxy_send_timeout 30s;
            proxy_read_timeout 30s;

            proxy_set_header Host $host;
            proxy_set_header X-Request-Id $request_id;
            proxy_set_header X-Real-IP ${EDGE_CLIENT_ADDRESS};
            proxy_set_header X-Forwarded-For ${EDGE_FORWARDED_FOR};
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Connection "";
        }
    }

    server {
        listen 8443 ssl ${EDGE_PROXY_PROTOCOL};
        server_name identity.staging.shape-of-you.ru;

        ssl_certificate /etc/nginx/tls/shape-of-you-staging/fullchain.pem;
        ssl_certificate_key /etc/nginx/tls/shape-of-you-staging/privkey.pem;

        add_header Strict-Transport-Security "max-age=86400" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;

        client_max_body_size 64k;

        location / {
            limit_req zone=api_per_ip burst=20 nodelay;

            proxy_pass http://identity:3000;
            proxy_http_version 1.1;
            proxy_connect_timeout 5s;
            proxy_send_timeout 30s;
            proxy_read_timeout 30s;

            proxy_set_header Host $host;
            proxy_set_header X-Request-Id $request_id;
            proxy_set_header X-Real-IP ${EDGE_CLIENT_ADDRESS};
            proxy_set_header X-Forwarded-For ${EDGE_FORWARDED_FOR};
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Connection "";
        }
    }
}
