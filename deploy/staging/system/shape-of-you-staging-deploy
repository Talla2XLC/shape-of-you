#!/bin/sh
set -eu

# Stable root-owned privilege boundary. This bootstrap deliberately knows only
# the bounded request envelope and CONTROL_SHA; the verified controller owns
# every evolving deployment field.
PATH=/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
export PATH LC_ALL

DEPLOY_ROOT=/opt/shape-of-you/staging
CONTROL_ROOT=$DEPLOY_ROOT/control
CONTROL_REPOSITORY=https://github.com/Talla2XLC/shape-of-you.git
CONTROL_BRANCH=main
LOCK_FILE=/run/shape-of-you-staging.lock
REQUEST_FILE=
MAX_REQUEST_BYTES=65536
MAX_REQUEST_LINES=128

cleanup() {
  if [ -n "$REQUEST_FILE" ]; then
    rm -f "$REQUEST_FILE"
  fi
}

trap cleanup EXIT HUP INT TERM

fail() {
  printf '%s\n' "$1" >&2
  exit 2
}

command -v flock >/dev/null 2>&1 || fail 'flock is required.'
exec 9>"$LOCK_FILE"
flock -n 9 || fail 'A staging deployment or certificate renewal is already active.'

[ "$#" -eq 0 ] || fail 'Deployment bootstrap accepts no arguments.'

umask 077
REQUEST_FILE=$(mktemp /run/shape-of-you-staging-request.XXXXXX)
head -c $((MAX_REQUEST_BYTES + 1)) > "$REQUEST_FILE"
request_bytes=$(wc -c < "$REQUEST_FILE")
[ "$request_bytes" -le "$MAX_REQUEST_BYTES" ] || fail 'Deployment request is too large.'
request_lines=0
control_sha=
control_sha_seen=false

while IFS= read -r input_line || [ -n "$input_line" ]; do
  request_lines=$((request_lines + 1))
  [ "$request_lines" -le "$MAX_REQUEST_LINES" ] || fail 'Deployment request has too many lines.'

  case "$input_line" in
    *=*)
      input_key=${input_line%%=*}
      input_value=${input_line#*=}
      ;;
    *)
      fail 'Malformed deployment input.'
      ;;
  esac

  case "$input_key" in
    ''|*[!A-Z0-9_]*) fail 'Invalid deployment input key.' ;;
  esac

  if [ "$input_key" = CONTROL_SHA ]; then
    [ "$control_sha_seen" = false ] || fail 'Duplicate input: CONTROL_SHA.'
    control_sha_seen=true
    control_sha=$input_value
  fi

done < "$REQUEST_FILE"

[ "$control_sha_seen" = true ] || fail 'CONTROL_SHA is required.'
printf '%s\n' "$control_sha" | grep -Eq '^[0-9a-f]{40}$' || fail 'Invalid CONTROL_SHA.'

if [ -d "$CONTROL_ROOT/.git" ]; then
  git -C "$CONTROL_ROOT" remote set-url origin "$CONTROL_REPOSITORY"
else
  test -d "$CONTROL_ROOT" || install -d -o root -g root -m 0755 "$CONTROL_ROOT"
  test -z "$(find "$CONTROL_ROOT" -mindepth 1 -maxdepth 1 -print -quit)" || \
    fail 'Control checkout path is unexpectedly non-empty.'
  git clone --no-checkout "$CONTROL_REPOSITORY" "$CONTROL_ROOT"
fi

git -C "$CONTROL_ROOT" fetch --depth=1 origin "$CONTROL_BRANCH"
control_head=$(git -C "$CONTROL_ROOT" rev-parse FETCH_HEAD)
[ "$control_sha" = "$control_head" ] || fail 'CONTROL_SHA does not match current origin/main.'
git -C "$CONTROL_ROOT" checkout --detach --force "$control_sha"

controller=$CONTROL_ROOT/deploy/staging/scripts/deployment-controller.sh
test -f "$controller" || fail 'Verified deployment controller is missing.'
test ! -L "$controller" || fail 'Verified deployment controller must not be a symbolic link.'

SHAPE_OF_YOU_STAGING_LOCK_HELD=true
export SHAPE_OF_YOU_STAGING_LOCK_HELD
sh "$controller" < "$REQUEST_FILE"
