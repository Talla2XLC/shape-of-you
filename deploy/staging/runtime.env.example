DATABASE_URL=postgresql://shape_of_you_api:replace-with-secret@host.docker.internal:5431/shape_of_you_api
PERSON_CONTEXT_MODE=authenticated
IDENTITY_OAUTH_ISSUER=https://identity.staging.shape-of-you.ru
IDENTITY_OAUTH_JWKS_URI=https://identity.staging.shape-of-you.ru/oauth/jwks
IDENTITY_OAUTH_RESOURCE=https://staging.shape-of-you.ru/api/mcp
API_BROWSER_ORIGIN=https://staging.shape-of-you.ru
API_BROWSER_OAUTH_CLIENT_ID=shape-of-you-web-staging
API_BROWSER_SESSION_KEYS=replace-with-a-secret-key-ring
# Garmin via Intervals.icu remains disabled until app approval and secrets are provisioned.
INTERVALS_ICU_ENABLED=false
# INTERVALS_ICU_CLIENT_ID is injected by the release environment when enabled.
# INTERVALS_ICU_CLIENT_SECRET is injected by the release environment when enabled.
# INTERVALS_ICU_REDIRECT_URI must be the exact registered HTTPS callback.
# INTEGRATION_ENCRYPTION_KEY_RING contains id:base64-32-byte-key entries.
# INTEGRATION_ENCRYPTION_ACTIVE_KEY_ID selects the write key without removing old read keys.
