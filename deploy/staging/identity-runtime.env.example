DATABASE_URL=postgresql://shape_of_you_identity:replace-with-secret@host.docker.internal:5431/shape_of_you_identity
IDENTITY_TOTP_ACTIVE_KEY_ID=staging-v1
IDENTITY_TOTP_ENCRYPTION_KEYS={"staging-v1":"replace-with-32-byte-base64url-secret"}
IDENTITY_OAUTH_ACTIVE_SIGNING_KEY_ID=staging-v1
IDENTITY_OAUTH_SIGNING_KEYS={"staging-v1":"replace-with-base64url-pkcs8-p256-private-key"}
IDENTITY_OAUTH_COOKIE_KEYS=["replace-with-32-byte-base64url-secret"]
IDENTITY_OAUTH_RESOURCE=https://staging.shape-of-you.ru/api/mcp
IDENTITY_CHATGPT_REDIRECT_URI=https://chatgpt.com/connector_platform_oauth_redirect
IDENTITY_WEB_REDIRECT_URI=https://staging.shape-of-you.ru/api/browser-auth/callback
