# Inject these values through the staging deployment mechanism. Never store real
# values in the repository. The service identity must have read-only access only
# to the exact Fitness Tracker workbook.
DATABASE_URL=postgresql://shape_of_you_api:replace-with-secret@host.docker.internal:5431/shape_of_you_api
FITNESS_TRACKER_PERSON_ID=replace-with-person-uuid
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=replace-with-read-only-service-identity
# Preserve the PKCS#8 key on one line with literal escaped newline sequences.
GOOGLE_SHEETS_SERVICE_ACCOUNT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nreplace-with-runtime-secret\n-----END PRIVATE KEY-----\n
