{
  "name": "shape-of-you",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "build": "pnpm -r --sort build",
    "dev": "pnpm --filter @shape-of-you/contracts build && pnpm --filter @shape-of-you/config build && IDENTITY_PUBLIC_ORIGIN=http://localhost:3002 NUXT_PUBLIC_IDENTITY_ORIGIN=http://localhost:3002 pnpm --parallel --filter @shape-of-you/api --filter @shape-of-you/identity --filter @shape-of-you/web dev:local",
    "local:dependencies": "docker compose up --detach --wait api-database identity-database",
    "local:up": "docker compose up --build --detach --wait api identity",
    "local:down": "docker compose down --remove-orphans",
    "local:reset": "docker compose down --volumes --remove-orphans",
    "local:migrate": "pnpm --filter @shape-of-you/api db:migrate:local && pnpm --filter @shape-of-you/identity db:migrate:local",
    "lint": "eslint .",
    "test": "pnpm -r --sort --if-present test",
    "test:unit": "pnpm -r --sort --if-present test:unit",
    "test:integration": "pnpm -r --sort --if-present test:integration",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:identity": "pnpm --filter @shape-of-you/identity test:e2e",
    "test:e2e:web": "pnpm --filter @shape-of-you/web test:e2e",
    "test:docs": "node --test scripts/validate-docs.test.mjs",
    "docs:validate": "node scripts/validate-docs.mjs",
    "typecheck": "pnpm --filter @shape-of-you/contracts build && pnpm --filter @shape-of-you/config build && pnpm -r --sort typecheck",
    "db:generate:api": "pnpm --filter @shape-of-you/api db:generate",
    "db:migrate:api": "pnpm --filter @shape-of-you/api db:migrate",
    "db:generate:identity": "pnpm --filter @shape-of-you/identity db:generate",
    "db:migrate:identity": "pnpm --filter @shape-of-you/identity db:migrate"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "10.10.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vue-eslint-parser": "10.4.1"
  }
}
